config BR2_PACKAGE_MOBIX_APP
	bool "mobix-app"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_LPRINT
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_TYPST # runtime
	help
	  The mobix Rust application (app/ in this repository): prints
	  MQTT messages with Typst on the LPrint receipt printer.
	  Supervised by BusyBox init (respawn).

comment "mobix-app needs a toolchain supported by Rust"
	depends on !BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS

comment "mobix-app needs lprint"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_LPRINT

#!/bin/sh
#
# LPrint label printer application (IPP Everywhere, web UI on port 8000).
# State lives in RAM (/var/lib/lprint.state); S00boot seeds it from
# /boot/lprint.state if present.
#

PIDFILE=/run/lprint.pid

case "$1" in
	start)
		mkdir -p /var/spool/lprint
		# libcups keeps the (self-signed, per-boot) TLS certificate here
		# and does not create the directory itself
		mkdir -p -m 0700 /etc/cups/ssl
		printf "Starting lprint: "
		# With HOME set, LPrint would use $HOME/.config/lprint.state;
		# XDG_DATA_HOME takes precedence and puts it in /var/lib
		XDG_DATA_HOME=/var/lib \
		start-stop-daemon -S -q -b -m -p $PIDFILE -x /usr/bin/lprint -- \
			server \
			-o log-file=syslog \
			-o log-level=info \
			-o spool-directory=/var/spool/lprint \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		start-stop-daemon -K -q -p $PIDFILE
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
